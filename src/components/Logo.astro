---
import { getLocale } from '@/i18n/routing';
import { defaultLanguage, type LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
const currentLocale =
  (getLocale(Astro.url.pathname) as LanguageCode | undefined) ?? defaultLanguage;
---

<a href={getRelativeLocaleUrl(currentLocale)}>
  <span class="text-2xl font-bold text-primary"> Your Logo </span>
</a>
