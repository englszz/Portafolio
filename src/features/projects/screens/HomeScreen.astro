---
import { homeContent } from '@/i18n/home';
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { MessageSquare, Briefcase, GraduationCap, Wrench, Users, Github, Linkedin, FileText } from 'lucide-react';

import heroImage from '@/assets/fotos/DamirónPFP.png';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import type { TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroGreeting: string;
  heroSubtitlePart1: string;
  heroSubtitlePart2: string;
  heroSubtitlePart3: string;
  heroIntroduction: string;
  heroViewWorkButton: string;
  heroContactButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string;
};

const {
  lang,
  projects,
  skills,
  heroGreeting,
  heroSubtitlePart1,
  heroSubtitlePart2,
  heroSubtitlePart3,
  heroIntroduction,
  heroViewWorkButton,
  heroContactButton,
  imageNotAvailable,
  featuredProjectsTitle,
  featuredProjectsDescription,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;
const copy = homeContent[lang];

---

{/* ─── HERO ─── */}
<section class="py-12 md:py-16">
  <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-center justify-between">
    {/* Hero Text Column */}
    <div class="min-w-0 text-center md:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-5 border border-primary/20">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        {copy.available}
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4">
        {heroGreeting}
      </h1>

      <p class="text-xl md:text-2xl font-medium text-muted-foreground mb-6">
        <span class="text-primary">{heroSubtitlePart1}</span> | <span class="text-primary">{heroSubtitlePart2}</span> | <span class="text-primary">{heroSubtitlePart3}</span>
      </p>

      <p class="text-base md:text-lg text-muted-foreground mb-8 max-w-xl mx-auto md:mx-0">
        {heroIntroduction}
      </p>

     {/* CTA Buttons */}
<div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center md:justify-start mb-8">
  {/* Botón: Ver proyectos */}
  <a
    href={getRelativeLocaleUrl(lang, "/projects")}
    class={buttonVariants({ variant: 'default', size: 'lg' })}
  >
    <Briefcase className="mr-2 size-4" />
    {heroViewWorkButton}
  </a>

  {/* Botón: Contacto */}
  <a
    href={getRelativeLocaleUrl(lang, "/contact")}
    class={buttonVariants({ variant: 'outline', size: 'lg' })}
  >
    <MessageSquare className="mr-2 size-4" />
    {heroContactButton}
  </a>

  {/* Botón: Formación */}
  <a
  href="#skills"
  class={buttonVariants({ variant: 'outline', size: 'lg' })}
>
  <GraduationCap className="mr-2 size-4" />
  {copy.educationLink}
</a>
</div>



      {/* Social Links */}
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <a
          href="https://github.com/englszz"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === "es" ? "GitHub de Engels Damirón" : "Engels Damirón on GitHub"}
          class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
        >
          <Github className="size-5 group-hover:text-primary transition-colors" />
          <span class="hidden sm:inline">GitHub</span>
        </a>
        <span class="text-muted-foreground/30">•</span>
        <a
          href="https://www.linkedin.com/in/engelsdamiron/?locale=en"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === "es" ? "LinkedIn de Engels Damirón" : "Engels Damirón on LinkedIn"}
          class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
        >
          <Linkedin className="size-5 group-hover:text-primary transition-colors" />
          <span class="hidden sm:inline">LinkedIn</span>
        </a>
        <span class="text-muted-foreground/30">•</span>
        <a
          href={lang === 'es' ? '/Engels_Damiron_CV_ES.pdf' : '/Engels_Damiron_CV_EN.pdf'}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={copy.cv}
          class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
        >
          <FileText className="size-5 group-hover:text-primary transition-colors" />
          <span class="hidden sm:inline">{copy.cv}</span>
        </a>
      </div>
    </div>

    {/* Hero Image */}
    <div class="md:text-center">
      <div
        class="w-full max-w-[600px] aspect-[600/368] bg-muted rounded-lg shadow-xl overflow-hidden mx-auto"
      >
        <Image
          src={heroImage}
          alt={lang === 'es' ? 'Foto de perfil de Engels Damirón' : 'Portrait of Engels Damirón'}
          width={600}
          height={368}
          densities={[1, 1.5, 2]}
          quality="high"
          class="h-full w-full object-cover"
          style="object-position: center 28%;"
        />
      </div>
    </div>
  </div>
</section>

<section id="about" class="py-14 md:py-20 border-t border-border/50">
  <div class="grid md:grid-cols-5 gap-10 items-start">
    <div class="md:col-span-2">
      <span class="text-primary font-semibold text-sm uppercase tracking-widest block mb-2">{copy.aboutLabel}</span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{copy.aboutTitle}</h2>
      <p class="text-muted-foreground text-sm">{copy.aboutIntro}</p>
    </div>
    <div class="md:col-span-3 space-y-4 text-muted-foreground leading-relaxed">
      {copy.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

{/* ─── PROYECTOS DESTACADOS ─── */}
<section id="projects" class="py-14 md:py-20 border-t border-border/50 bg-muted/20 dark:bg-muted/10">
  <Heading as="h2"
    title={featuredProjectsTitle}
    description={featuredProjectsDescription}
    className="flex flex-col items-center"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.slice(0, 3).map((project: TranslatedProject) => {
        return (
          <FeaturedProjectPreview
            lang={lang}
            slug={project.slug}
            title={project.title}
            description={project.description}
            imageUrl={project.imageUrl}
            imageAltText={project.imageAltText}
            ctaText={projectPreviewCtaText}
            technologiesUsed={[]}
          />
        );
      })
    }
  </div>

  <div class="mt-10 text-center">
    <a
      href={getRelativeLocaleUrl(lang, '/projects')}
      class={buttonVariants({ variant: 'outline', size: 'lg' })}
    >
      {copy.allProjects} →
    </a>
  </div>
</section>

<section class="py-14 md:py-20 border-t border-border/50">
  <div class="max-w-3xl mx-auto">
    <div class="mb-8 text-center md:text-left">
      <span class="text-primary font-semibold text-sm uppercase tracking-widest block mb-2">{copy.nowLabel}</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{copy.nowTitle}</h2>
    </div>
    <div class="relative pl-8 sm:pl-10 border-l-2 border-border ml-2 sm:ml-4 py-1">
      <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></div>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed">{copy.now}</p>
    </div>
  </div>
</section>

<section id="skills" class="py-14 md:py-20 border-t border-border/50">
  <div class="mb-12 text-center">
    <span class="text-primary font-semibold text-sm uppercase tracking-widest block mb-2">{copy.profile}</span>
    <h2 class="text-3xl md:text-4xl font-bold mb-3">{mySkillsTitle}</h2>
    <p class="text-muted-foreground max-w-xl mx-auto">{mySkillsDescription}</p>
  </div>
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-5">
      <GraduationCap className="size-5 text-primary" />
      <h3 class="text-xl font-semibold">{copy.educationTitle}</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {copy.education.map((item) => <div class="border border-border rounded-xl p-5 bg-card">
        <p class="font-semibold">{item.title}</p><p class="text-sm text-muted-foreground mt-1">{item.detail}</p>
      </div>)}
    </div>
  </div>
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-5">
      <Briefcase className="size-5 text-primary" /><h3 class="text-xl font-semibold">{copy.experienceTitle}</h3>
    </div>
    <div class="space-y-4">
      {copy.experience.map((item) => <div class="border border-border rounded-xl p-5 bg-card space-y-3">
        <p class="font-semibold text-lg">{item.title}</p><p class="text-sm text-muted-foreground font-medium">{item.dates}</p>
        <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
      </div>)}
    </div>
  </div>
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-5">
      <Wrench className="size-5 text-primary" /><h3 class="text-xl font-semibold">{copy.technicalTitle}</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {skills.map((skill) => <SkillCard title={skill.title} description={skill.description} iconName={skill.iconName} technologies={skill.technologies} />)}
    </div>
  </div>
  <div class="mb-10">
    <h3 class="text-xl font-semibold mb-5">{copy.languagesTitle}</h3>
    <div class="border border-border rounded-xl p-5 bg-card">
      <p class="font-semibold">{copy.language.title}</p>
      <p class="text-sm text-muted-foreground mt-1">{copy.language.detail}</p>
      <p class="text-sm text-muted-foreground mt-3">{copy.language.description}</p>
    </div>
  </div>
  <div>
    <div class="flex items-center gap-3 mb-5">
      <Users className="size-5 text-primary" /><h3 class="text-xl font-semibold">{copy.professionalTitle}</h3>
    </div>
    <p class="text-muted-foreground leading-relaxed mb-5">{copy.professional}</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {copy.soft.map((soft) => <div class="border border-border rounded-lg px-4 py-3 text-sm text-center font-medium">{soft}</div>)}
    </div>
  </div>
</section>
