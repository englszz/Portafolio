---
import { getLocale } from '@/i18n/routing';
import '../styles/global.css';
import shareImage from '@/assets/fotos/DamirónPFP.png';
import { defaultLanguage, useTranslations, type LanguageCode } from '@/i18n/ui';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import BottomAppBar from '@/components/BottomAppBar.astro';
import { Home, Briefcase, FileText, Lightbulb, MessageSquare } from 'lucide-react';
import { ClientRouter } from 'astro:transitions';

import {
  prepareLanguagesForSelector,
  type LanguageSelectorItem,
} from '@/lib/i18n-utils';
import { Toaster } from 'sonner';

type Props = {
  pageTitle: string;
  pageDescription?: string;
  pageImage?: string;
};

export type NavItem = {
  href: string;
  label: string;
  icon: any;
};

const { pageTitle, pageDescription, pageImage } = Astro.props;
const lang =
  (getLocale(Astro.url.pathname) as LanguageCode | undefined) ?? defaultLanguage;
const currentPathname = Astro.url.pathname;
const site = Astro.site ?? new URL('https://engelsdamiron.me');
const is404 = /\/404(?:\.html)?\/?$/.test(currentPathname);
const canonical = new URL(is404 && lang === "es" ? "/404.html" : currentPathname, site);
const basePath = currentPathname.replace(/^\/en(?=\/|$)/, '') || '/';
const spanishUrl = new URL(is404 ? "/404.html" : basePath, site);
const englishUrl = new URL(is404 ? '/en/404/' : '/en' + (basePath === '/' ? '/' : basePath), site);
const socialImage = new URL(pageImage ?? shareImage.src, site);

const tSite = useTranslations(lang, 'site');
const tNav = useTranslations(lang, 'nav');

const navItems: Array<NavItem> = [
  { href: '/', label: tNav('home'), icon: Home },
  { href: '/projects', label: tNav('projects'), icon: Briefcase },
  { href: '/blog', label: tNav('blog'), icon: FileText },
  { href: '/contact', label: tNav('contact'), icon: MessageSquare },
];

const languagesForSelector: Array<LanguageSelectorItem> =
  prepareLanguagesForSelector(currentPathname, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={pageDescription || tSite('description')}
    />

    <link rel="icon" type="image/png" href="/favicons/dark-mode/ed.png" sizes="96x96" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicons/light-mode/ed1.png" sizes="96x96" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicons/dark-mode/ed.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/dark-mode/ed.png" />
    <link rel="manifest" href="/favicons/dark-mode/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Engels Damirón" />
    <meta property="og:title" content={pageTitle || tSite('title')} />
    <meta property="og:description" content={pageDescription || tSite('description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_DO'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle || tSite('title')} />
    <meta name="twitter:description" content={pageDescription || tSite('description')} />
    <meta name="twitter:image" content={socialImage} />

    <script is:inline>
      (function() {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <title>{pageTitle || tSite('title')}</title>

    {/* Font, for example Google Fonts - to adapt according to your choices */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="h-[100dvh] bg-background font-sans antialiased flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-background focus:p-3">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="hidden md:block">
      <!-- passer aussi navItems mais sans le premier element dont le href === '/' -->
      <Header
        navItems={navItems.filter((item) => item.href !== '/') as NavItem[]}
      />
    </header>

    <main id="main-content"
      class="container mx-auto px-4 py-8 flex-1 max-w-screen-2xl pb-20 md:pb-8"
    >
      <slot />
    </main>
    <div class="hidden md:block">
      <Footer />
    </div>
    <BottomAppBar
      navItems={navItems}
      languagesForSelector={languagesForSelector}
    />
    <Toaster position="bottom-right" richColors client:load />
    {/* Global scripts if needed, for example for analytics */}
    <script is:inline type="text/javascript">
      document.addEventListener('DOMContentLoaded', () => {
        const initializeAndRunMermaid = () => {
          const mermaidNodes = document.querySelectorAll('pre.mermaid');
          if (mermaidNodes.length === 0) return;

          if (typeof mermaid !== 'undefined') {
            const isDarkMode =
              document.documentElement.classList.contains('dark');
            const mermaidTheme = isDarkMode ? 'dark' : 'default';

            let themeVars = {
              fontFamily: '"Inter", sans-serif',
              fontSize: '15px',
              primaryColor: isDarkMode ? '#3B0764' : '#F3EFFF',
              primaryTextColor: isDarkMode ? '#F3F4F6' : '#1f2937',
              primaryBorderColor: isDarkMode ? '#A78BFA' : '#9333ea',
              lineColor: isDarkMode ? '#A78BFA' : '#7E22CE',
              textColor: isDarkMode ? '#E5E7EB' : '#374151',
              edgeLabelBackground: isDarkMode ? '#4B3264' : '#E9D5FF',
              actorBkg: isDarkMode ? '#3B0764' : '#F3EFFF',
              actorBorder: isDarkMode ? '#A78BFA' : '#9333ea',
              labelBoxBkgColor: isDarkMode ? '#2e104f' : '#f7f2ff',
              labelTextColor: isDarkMode ? '#E5E7EB' : '#374151',
              noteBkgColor: isDarkMode ? '#2a0f4a' : '#fbf7ff',
              noteTextColor: isDarkMode ? '#E5E7EB' : '#374151',
              clusterBkg: isDarkMode ? '#240a3c' : '#faf5ff',
              clusterBorder: isDarkMode ? '#7c3aed' : '#a855f7',
            };

            mermaid.initialize({
              startOnLoad: false,
              theme: mermaidTheme,
              themeVariables: themeVars,
            });

            mermaid.run({ nodes: mermaidNodes });
          } else if (!document.querySelector('script[data-mermaid-loaded]')) {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11.6.0/dist/mermaid.min.js';
            script.defer = true;
            script.setAttribute('data-mermaid-loaded', 'true');
            script.onload = () => initializeAndRunMermaid();
            document.head.appendChild(script);
          }
        };

        initializeAndRunMermaid();
        document.addEventListener('astro:after-swap', initializeAndRunMermaid);
      });
    </script>
  </body>
</html>
