---
import { getLocale } from '@/i18n/routing';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLanguage, useTranslations, type LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import errorIllustration from '@/assets/fotos/error.png';
import errorIllustrationDark from '@/assets/fotos/error-dark.png';
import { buttonVariants } from '@/components/ui/button';
import Heading from '@/components/Heading.astro';
import { ArrowLeft } from 'lucide-react';

const lang =
  (getLocale(Astro.url.pathname) as LanguageCode | undefined) ?? defaultLanguage;
const t = useTranslations(lang, 'notFoundPage');

const pageTitle = t('pageTitle');
const pageDescription = t('message');
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <section class="text-center py-12">
    <div class="container mx-auto px-4 max-w-2xl">
      <Image
        src={errorIllustration}
        alt={lang === "es" ? "Ilustración de error en modo claro" : "Error illustration in light mode"}
        class="w-64 h-auto mx-auto mb-8 block dark:hidden"
        densities={[1, 1.5, 2]}
        quality="mid"
      />
      <Image
        src={errorIllustrationDark}
        alt={lang === "es" ? "Ilustración de error en modo oscuro" : "Error illustration in dark mode"}
        class="w-64 h-auto mx-auto mb-8 hidden dark:block"
        densities={[1, 1.5, 2]}
        quality="mid"
      />
      <Heading
        title={t('title')}
        description={t('message')}
        titleClassName="md:text-5xl"
      />

      <a
        href={getRelativeLocaleUrl(lang, '/')}
        class={buttonVariants({ variant: 'default' })}
      >
        <ArrowLeft className="mr-2 size-4" />
        {t('homeLink')}</a
      >
    </div>
  </section>
</BaseLayout>
